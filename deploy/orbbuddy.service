[Unit]
Description=OrbBuddy Android relay and MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/orbbuddy
EnvironmentFile=/etc/orbbuddy/server.env
ExecStart=/opt/orbbuddy/orbbuddy-server
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
